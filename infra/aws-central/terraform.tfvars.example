name               = "ore-heaphound-prod"
region             = "us-west-2"
anchor_bucket_name = "replace-with-globally-unique-object-lock-bucket"
# The prerequisite/bootstrap state must already own an empty KMS-encrypted
# secret. For a fresh installation this may be omitted and defaults to
# /<name>/operator. During reconciliation, set it to the exact existing path.
# AWS central references this object; never import it into aws-central state.
# operator_secret_name = "/ore-heaphound/existing-deployment-id/operator"
cluster_endpoint_public_access_cidrs = ["203.0.113.10/32"]
source_bucket_arns = [
  "arn:aws:s3:::replace-with-approved-source-bucket",
]

# One on-demand GPU node always hosts the baseline model replica. This toggle
# controls only additional on-demand scan-worker fallback; GPU replicas 2+ use
# Spot and wait when Spot is unavailable.
enable_on_demand_fallback = true
llm_baseline_instance_types = [
  "g6.xlarge",
  "g5.xlarge",
]

# Three system nodes provide enough requested CPU for a concurrent application
# rollout. Change these only with a reviewed capacity calculation.
system_node_min_size     = 3
system_node_desired_size = 3
system_node_max_size     = 6

# Scan nodes remain diversified by default. A reviewed high-throughput
# production overlay can prefer several compatible general-purpose families and
# sizes without patching the live Karpenter NodePool:
#
# scan_instance_families       = ["m8a", "m7a", "m6a"]
# scan_min_instance_generation = 6
# scan_min_instance_vcpu       = 16
# scan_instance_vcpus          = [8, 16, 32]
# This keeps the reviewed AMD memory/CPU shape while giving Spot multiple
# generations and sizes in each availability zone.
#
# Keep Spot as the primary capacity type. Exact-family constraints reduce the
# available Spot capacity pool, so validate the selected family in every
# configured availability zone before applying.

# Optional lower-priority on-demand GPU fallback for a bounded Ollama burst:
#
# enable_llm_on_demand_burst    = true
# llm_on_demand_burst_gpu_limit = 3
# enable_spot_to_spot_consolidation = true
#
# RDS gp3 performance profile used by a high-throughput production site.
# PostgreSQL requires at least 400 GiB before custom gp3 IOPS/throughput can
# be provisioned. Allocated storage cannot later be reduced.
#
# database_allocated_storage      = 400
# database_max_allocated_storage  = 2000
# database_iops                   = 12000
# database_storage_throughput     = 500

# Infrastructure tags are identity, not mutable software-version metadata.
# During reconciliation copy the exact existing tag map from the approved
# state/configuration. Do not replace an existing ReleaseTag with the new tag.

# Governed source remediation (FR-8). When true, Terraform creates the
# write-scoped executor IRSA role plus the quarantine and redacted buckets.
# Leave false for a discovery-and-triage-only deployment: no identity in the
# whole deployment can then write or delete a source object.
remediation_enabled                 = false
remediation_rollback_retention_days = 7
